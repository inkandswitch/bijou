def i64.decode
  (buf : Slice Std.U8) :
  Result (core.result.Result (Std.I64 × Std.Usize) u64.DecodeError)
  := do
  let r ← u64.decode buf
  match r with
  | core.result.Result.Ok p =>
    let (value, consumed) := p
