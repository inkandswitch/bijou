/-- `<[T]>::split_first`: `None` on an empty slice, otherwise the first
element and the rest. Never panics. -/
@[rust_fun "core::slice::{[@T]}::split_first"]
def core.slice.Slice.split_first {T : Type _} (s : Slice T) :
    Result (Option (T × (Slice T))) :=
  ok (match h : s.val with
    | [] => none
    | x :: xs => some (x, Slice.from xs (by
        have := s.property
        rw [h] at this
        simp at this
        omega)))

/-- `<[T]>::first_chunk::<N>`: the first `N` elements as an array if the
slice has at least `N`, otherwise `None`. Never panics. -/
@[rust_fun "core::slice::{[@T]}::first_chunk"]
def core.slice.Slice.first_chunk {T : Type _} (N : Std.Usize) (s : Slice T) :
    Result (Option (Array T N)) :=
  ok (if h : N.val ≤ s.val.length then
    some (Array.make N (s.val.take N.val) (by simp [h]))
  else none)

/-- `Vec::truncate`: keep the first `n` elements (no-op if already shorter).
Never panics. The allocator parameter is irrelevant to the contents. -/
@[rust_fun "alloc::vec::{alloc::vec::Vec<@T>}::truncate"]
def alloc.vec.Vec.truncate {T : Type _} (A : Type _) (v : alloc.vec.Vec T) (n : Std.Usize) :
    Result (alloc.vec.Vec T) :=
  ok (alloc.vec.Vec.from (v.val.take n.val) (by
    have := v.property
    simp))
