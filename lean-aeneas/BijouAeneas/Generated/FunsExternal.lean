/-- `u32::saturating_mul`: the product, clamped to `u32::MAX`. Never panics. -/
@[rust_fun "core::num::{u32}::saturating_mul"]
def core.num.U32.saturating_mul (x y : Std.U32) : Result Std.U32 :=
  ok ⟨BitVec.ofNat _ (Min.min (UScalar.max .U32) (x.val * y.val))⟩

