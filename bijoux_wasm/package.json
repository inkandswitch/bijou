{
  "name": "@inkandswitch/bijoux",
  "version": "0.1.0",
  "description": "Bijective length-prefixed varint encodings for u32/u64/u128 (Wasm bindings)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "keywords": [
    "bijective",
    "canonical",
    "encoding",
    "varint",
    "wasm"
  ],
  "author": "Brooklyn Zelenka <hello@brooklynzelenka.com>",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/inkandswitch/bijou",
    "directory": "bijoux_wasm"
  },
  "homepage": "https://github.com/inkandswitch/bijou",
  "bugs": {
    "url": "https://github.com/inkandswitch/bijou/issues"
  },
  "scripts": {
    "test:js": "pnpm run test:js:node && pnpm run test:js:browser",
    "test:js:browser": "playwright test",
    "test:js:browser:report": "playwright show-report",
    "test:js:node": "mocha"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^6.2.2",
    "http-server": "^14.1.1",
    "mocha": "^11.7.5",
    "tsx": "^4.22.2",
    "typescript": "^5.7.2"
  },
  "main": "./dist/cjs/node.cjs",
  "module": "./dist/esm/bundler.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/esm/bundler.js",
    "./dist/esm/node.js",
    "./dist/esm/web.js",
    "./dist/esm/workerd.js",
    "./dist/esm/debug-bundler.js",
    "./dist/esm/debug-node.js",
    "./dist/esm/debug-web.js",
    "./dist/esm/debug-workerd.js"
  ],
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": {
        "import": "./dist/esm/workerd.js",
        "require": "./dist/cjs/web.cjs"
      },
      "node": {
        "import": "./dist/esm/node.js",
        "require": "./dist/cjs/node.cjs"
      },
      "browser": {
        "import": "./dist/esm/bundler.js",
        "require": "./dist/cjs/web.cjs"
      },
      "import": "./dist/esm/web.js",
      "require": "./dist/cjs/web.cjs"
    },
    "./slim": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/slim.js",
      "require": "./dist/cjs/slim.cjs"
    },
    "./wasm": "./dist/bijoux.wasm",
    "./wasm-base64": {
      "import": "./dist/esm/wasm-base64.js",
      "require": "./dist/cjs/wasm-base64.cjs"
    },
    "./iife": "./dist/iife/index.js",
    "./debug": {
      "types": "./dist/index.d.ts",
      "workerd": {
        "import": "./dist/esm/debug-workerd.js",
        "require": "./dist/cjs/debug-web.cjs"
      },
      "node": {
        "import": "./dist/esm/debug-node.js",
        "require": "./dist/cjs/debug-node.cjs"
      },
      "browser": {
        "import": "./dist/esm/debug-bundler.js",
        "require": "./dist/cjs/debug-web.cjs"
      },
      "import": "./dist/esm/debug-web.js",
      "require": "./dist/cjs/debug-web.cjs"
    },
    "./debug/slim": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/debug-slim.js",
      "require": "./dist/cjs/debug-slim.cjs"
    },
    "./debug/wasm": "./dist/bijoux-debug.wasm",
    "./debug/wasm-base64": {
      "import": "./dist/esm/debug-wasm-base64.js",
      "require": "./dist/cjs/debug-wasm-base64.cjs"
    },
    "./debug/iife": "./dist/iife/debug.js"
  }
}